{
  "compilerOptions": {
    "target": "es2023", "lib": ["es2023"], "types": ["node"],
    "module": "nodenext", "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true, "noEmit": true,
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true
  },
  "include": ["*.ts"]
}
